# LLM for the working assistant (optional for local document search)
POLZA_RUNTIME_API_KEY=replace-with-a-new-key
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL=qwen/qwen3.8-flash

# Web server
PORT=3000
HOST=127.0.0.1
STATE_DIR=data
DB_PATH=data/mvp.sqlite

# Quality team mailbox
QUALITY_EMAIL=quality@example.org
QUALITY_ADMIN_TOKEN=replace-with-a-long-random-token

# Gmail SMTP; use a Google App Password, never your normal account password
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465

# Optional OpenAI-compatible embeddings endpoint; leave blank for lexical-only search.
# Choose a model whose license permits local deployment.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_MODEL=baai/bge-m3
EMBEDDINGS_API_KEY=

